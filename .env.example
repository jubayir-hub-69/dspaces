# Vercel KV — required for host roles, avatars, and transcripts across serverless instances
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: public webhook URL for dTelecom SFU events
# WEBHOOK_URL=https://your-domain.com/api/webhook
