# dTelecom Cloud — https://cloud.dtelecom.org
DTELECOM_API_KEY=
DTELECOM_API_SECRET=

# Google Gemini (AI chat, summaries, and server-side transcription)
GEMINI_API_KEY=

# Email OTP (Nodemailer)
EMAIL_USER=
EMAIL_PASS=
